# --- Required ---------------------------------------------------------------
# pyannote/speaker-diarization-community-1 is a GATED model.
# 1. Create a token at https://hf.co/settings/tokens  (read access is enough)
# 2. Accept the terms at https://hf.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# --- Models -----------------------------------------------------------------
ASR_MODEL=large-v3
# int8_float16 keeps large-v3 at ~3 GB VRAM. Use float16 if you ever get a bigger GPU.
ASR_COMPUTE_TYPE=int8_float16
ASR_BATCH_SIZE=8
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MUSIC_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593

# --- Optional local LLM summary (docker compose --profile llm) ---------------
LLM_ENABLED=false
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://ollama:11434

# --- Server -----------------------------------------------------------------
HOST_PORT=8080
DATA_DIR=/data
LOG_LEVEL=INFO
